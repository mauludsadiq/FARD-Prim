/// ocir_licm.fard -- Loop Invariant Code Motion at OCIR level
///
/// Uses MemSSA to determine which LoadHeap instructions are loop-invariant:
/// a load is invariant iff its reaching MemDef is defined outside the loop.
///
/// Also hoists pure arithmetic (AddI64/SubI64/MulI64/DivI64/ModI64/CmpI64)
/// whose operands are all defined outside the loop.

import("std/list") as list
import("std/rec")  as rec
import("std/str")  as str
import("../orgntr_prim/ocir_loop_ir")  as loop_ir
import("../orgntr_prim/ocir_memssa")   as memssa
import("../orgntr_prim/ocir_domtree")  as domtree

// Collect all regs defined inside the loop body blocks
fn collect_loop_defs(body_labels, blocks) {
  let body_set = list.fold(body_labels, {}, fn(acc, l) {
    rec.set(acc, str.from(l), true)
  }) in
  list.fold(blocks, {}, fn(acc, b) {
    if !rec.has(body_set, str.from(b.label)) then acc
    else list.fold(b.insts, acc, fn(a, inst) {
      if rec.has(inst, "dst") then rec.set(a, str.from(inst.dst), true)
      else a
    })
  })
}

// Collect instruction indices that belong to loop body blocks
// Returns set of (block_label_str, inst_idx) encoded as "label:idx"
fn collect_loop_inst_indices(body_labels, blocks) {
  let body_set = list.fold(body_labels, {}, fn(acc, l) {
    rec.set(acc, str.from(l), true)
  }) in
  list.fold(blocks, {}, fn(acc, b) {
    if !rec.has(body_set, str.from(b.label)) then acc
    else
      let n = list.len(b.insts) in
      list.fold(list.build(n, fn(i){i}), acc, fn(a, i) {
        rec.set(a, str.concat([str.from(b.label), ":", str.from(i)]), true)
      })
  })
}

// Is a MemDef version produced inside the loop?
// A MemDef at inst_idx i in block b is inside the loop if b is a body block.
fn mem_def_in_loop(mem_nodes, body_set) {
  // Build set of MemDef versions that are produced inside the loop
  list.fold(mem_nodes, {}, fn(acc, node) {
    if node.op == "MemDef" || node.op == "MemBarrier" then
      // We can't easily map inst_idx back to block without more info.
      // Conservative: any MemDef is considered potentially inside the loop.
      // This is fixed by the full mem-SSA version below.
      acc
    else acc
  })
}

// For a LoadHeap, check if its reaching memory version was defined outside the loop.
// We do this by checking: does any MemDef inside the loop body have a version
// >= the load's reaching version? If no loop-body MemDef exists with version
// that the load might read, the load is invariant.
fn load_is_mem_invariant(inst, inst_block_label, inst_idx_in_block,
                          mem_nodes, body_set) {
  // Find the MemUse for this load
  let use_node = list.find(mem_nodes, fn(n) {
    n.op == "MemUse" && n.inst_idx == inst_idx_in_block
  }) in
  if !rec.has(use_node, "some") then false  // conservative
  else
    let reaching_ver = use_node.some.version in
    // Find all MemDefs inside the loop body
    let loop_def_versions = list.map(
      list.filter(mem_nodes, fn(n) {
        (n.op == "MemDef" || n.op == "MemBarrier") &&
        rec.has(body_set, str.from(n.inst_idx))
        // Note: inst_idx here is a block-local index, not unique globally.
        // We use a coarser check below.
      }),
      fn(n){ n.version }
    ) in
    // If any loop-body MemDef has version <= reaching_ver, the load might
    // read a value written by the loop. Conservative: if any loop body
    // MemDef exists, assume the load may not be invariant unless we have
    // full alias info.
    list.len(loop_def_versions) == 0
}

fn is_pure_arithmetic(op) {
  op == "ImmI64" || op == "ImmBool" ||
  op == "AddI64" || op == "SubI64" || op == "MulI64" ||
  op == "DivI64" || op == "ModI64" || op == "CmpI64" ||
  op == "ImmI64" || op == "ImmBool" || op == "CopyI64"
}

fn operands_outside_loop(inst, loop_defs) {
  let op = inst.op in
  if op == "ImmI64" || op == "ImmBool" then true
  else if op == "CopyI64" then !rec.has(loop_defs, str.from(inst.src))
  else if op == "AddI64" || op == "SubI64" || op == "MulI64" ||
          op == "DivI64" || op == "ModI64" || op == "CmpI64" then
    !rec.has(loop_defs, str.from(inst.lhs)) &&
    !rec.has(loop_defs, str.from(inst.rhs))
  else false
}

fn licm_func(f) {
  if list.len(f.blocks) == 0 then f else
  let blocks = f.blocks in
  let entry_label = if list.len(blocks) > 0 then list.get(blocks, 0).label else 0 in
  let cfg = domtree.analyze_cfg(blocks, entry_label) in
  let loops = loop_ir.detect_loops_func(f, cfg) in
  if list.len(loops) == 0 then f else

  // Build mem-SSA for alias-aware invariance checking
  let mem_info = memssa.build_memssa_func(f) in
  let mem_nodes = mem_info.mem_nodes in

  // DEBUG: print loop structure
  let _ = list.map(loops, fn(lp) {
    str.concat(["loop header=", str.from(lp.header), 
                " preheader=", str.from(lp.preheader),
                " body=", str.from(list.len(lp.body)), "blocks"])
  }) in
  // Collect defs from ALL loop bodies -- a reg defined in any loop is
  // not invariant for any nested loop (it may change across outer iterations)
  let all_body_labels = list.flatten(list.map(loops, fn(lp){ lp.body })) in
  let all_loop_defs = collect_loop_defs(all_body_labels, blocks) in

  // For each loop, collect invariant insts and hoist to preheader
  let result = list.fold(loops, blocks, fn(cur_blocks, lp) {
    let body_labels = lp.body in
    let preheader = lp.preheader in
    // Skip self-loops, degenerate loops, and loops without valid preheader
    if preheader == null || preheader == -1 then cur_blocks else
    if lp.header == lp.latch then cur_blocks else

    let body_set = list.fold(body_labels, {}, fn(acc, l) {
      rec.set(acc, str.from(l), true)
    }) in

    // Collect all loop body MemDefs to check load invariance
    let loop_has_stores = list.any(cur_blocks, fn(b) {
      if !rec.has(body_set, str.from(b.label)) then false
      else list.any(b.insts, fn(inst) {
        memssa.is_mem_def(inst.op)
      })
    }) in

    // Use all_loop_defs: regs defined in ANY loop body are not invariant
    let loop_defs = all_loop_defs in

    // Find invariant instructions in body blocks (excluding header - it may
    // contain loop-varying initialization code for inner loops)
    let hoistable = list.flatten(list.map(cur_blocks, fn(b) {
      if !rec.has(body_set, str.from(b.label)) then []
      else if b.label == lp.header then []  // never hoist from header
      else list.filter(b.insts, fn(inst) {
        let op = inst.op in
        if is_pure_arithmetic(op) then
          operands_outside_loop(inst, loop_defs)
        else if (op == "LoadHeap" || op == "LoadHeapStaticIdx") && !loop_has_stores then
          // Only hoist loads if no stores exist in the loop body
          !rec.has(loop_defs, str.from(inst.ptr))
        else false
      })
    })) in

    if list.len(hoistable) == 0 then cur_blocks else

    // Track hoistable dsts per body block for safe removal
    let hoisted_dsts = list.fold(hoistable, {}, fn(acc, inst) {
      if rec.has(inst, "dst") then rec.set(acc, str.from(inst.dst), true)
      else acc
    }) in

    list.map(cur_blocks, fn(b) {
      if b.label == preheader then
        // Append after existing preheader insts so operands are available
        { label: b.label, insts: list.concat([b.insts, hoistable]), term: b.term }
      else if rec.has(body_set, str.from(b.label)) then
        // Remove hoisted insts from this body block by dst identity
        // Safe: OCIR at this stage has unique dsts (SSA form preserved by opts)
        { label: b.label,
          insts: list.filter(b.insts, fn(inst) {
            if rec.has(inst, "dst") then !rec.has(hoisted_dsts, str.from(inst.dst))
            else true
          }),
          term: b.term }
      else b
    })
  }) in

  if list.len(loops) == 0 then f else rec.set(f, "blocks", result)
}

fn licm_module(m) {
  { entry: m.entry, funcs: list.map(m.funcs, fn(f) { licm_func(f) }) }
}

export { licm_module }
