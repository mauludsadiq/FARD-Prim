/// ocir_dump -- run pipeline to a named pass, return OCIR as JSON string
import("../orgntr_prim/python_to_uvir")  as py
import("../orgntr_prim/uvir_to_ocir")    as bridge
import("../orgntr_prim/ocir_opt")        as opt
import("../orgntr_prim/ocir_inline")     as inl
import("../orgntr_prim/ocir_dfe")        as dfe
import("../orgntr_prim/ocir_sr")         as sr
import("../orgntr_prim/ocir_gvn")        as gvn
import("../orgntr_prim/ocir_jt")         as jt
import("../orgntr_prim/ocir_loop_fuse")  as fuse
import("../orgntr_prim/ocir_licm")       as ocir_licm
import("../orgntr_prim/ocir_iv_sr")      as ocir_iv_sr
import("../orgntr_prim/ocir_sccp")       as sccp
import("../orgntr_prim/ocir")            as ocir_mod
import("std/json") as json
import("std/list") as list
import("std/str")  as str

fn count_op(m, op) {
  list.fold(m.funcs, 0, fn(acc, f) {
    list.fold(f.blocks, acc, fn(acc2, b) {
      list.fold(b.insts, acc2, fn(acc3, i) {
        if i.op == op then acc3 + 1 else acc3
      })
    })
  })
}

fn count_blocks(m) {
  list.fold(m.funcs, 0, fn(acc, f) { acc + list.len(f.blocks) })
}

fn count_insts(m) {
  list.fold(m.funcs, 0, fn(acc, f) {
    list.fold(f.blocks, acc, fn(acc2, b) { acc2 + list.len(b.insts) })
  })
}

fn has_op(m, op) { count_op(m, op) > 0 }

fn ops_in_func(m, fname) {
  list.fold(m.funcs, [], fn(acc, f) {
    if f.name == fname then
      list.fold(f.blocks, acc, fn(acc2, b) {
        list.concat([acc2, list.map(b.insts, fn(i) { i.op })])
      })
    else acc
  })
}

fn pipeline_to_ocir(py_ast) {
  let uvir_mod = py.lower_module(py_ast) in
  bridge.lower_module(uvir_mod)
}

fn pipeline_to_p1(py_ast) {
  let ocir = pipeline_to_ocir(py_ast) in
  opt.opt_module(sccp.sccp_module(opt.opt_module(ocir)))
}

fn pipeline_to_p3(py_ast) {
  let p1 = pipeline_to_p1(py_ast) in
  let p2 = sr.sr_module(p1) in
  inl.inline_module(p2)
}

fn pipeline_to_p4(py_ast) {
  let p3 = pipeline_to_p3(py_ast) in
  let p4 = dfe.dfe_module(opt.opt_module(gvn.gvn_module(sccp.sccp_module(opt.opt_module(p3))))) in
  opt.compute_alloc_ptrmasks(p4)
}

fn pipeline_to_licm(py_ast) {
  let p4 = pipeline_to_p4(py_ast) in
  let p5 = opt.opt_module(jt.jt_module(p4)) in
  let p5 = opt.opt_module(fuse.fuse_module(p5)) in
  ocir_licm.licm_module(p5)
}

fn pipeline_to_ivsr(py_ast) {
  let licm = pipeline_to_licm(py_ast) in
  ocir_iv_sr.iv_sr_module(licm)
}

export {
  pipeline_to_ocir,
  metrics,
  pass_metrics,
  count_insts_in_block,
  block_op_counts,
  pipeline_to_p1,
  pipeline_to_p3,
  pipeline_to_p4,
  pipeline_to_licm,
  pipeline_to_ivsr,
  count_op,
  count_blocks,
  count_insts,
  has_op,
  ops_in_func,
}

fn metrics(m) {
  {
    insts:  count_insts(m),
    blocks: count_blocks(m),
    mul:    count_op(m, "MulI64"),
    add:    count_op(m, "AddI64"),
    imm:    count_op(m, "ImmI64"),
    cmp:    count_op(m, "CmpI64"),
    load:   count_op(m, "LoadHeap"),
    store:  count_op(m, "StoreHeap"),
    call:   count_op(m, "CallDirect")
  }
}

fn pass_metrics(py_ast) {
  let m0 = pipeline_to_ocir(py_ast) in
  let m1 = pipeline_to_p1(py_ast) in
  let m3 = pipeline_to_p3(py_ast) in
  let m4 = pipeline_to_p4(py_ast) in
  let ml = pipeline_to_licm(py_ast) in
  let mi = pipeline_to_ivsr(py_ast) in
  {
    ocir:   metrics(m0),
    sccp:   metrics(m1),
    inline: metrics(m3),
    gvn:    metrics(m4),
    licm:   metrics(ml),
    ivsr:   metrics(mi)
  }
}

fn count_insts_in_block(m, fname, blabel) {
  list.fold(m.funcs, 0, fn(acc, f) {
    if f.name == fname then
      list.fold(f.blocks, acc, fn(acc2, b) {
        if b.label == blabel then list.len(b.insts) else acc2
      })
    else acc
  })
}

fn block_op_counts(m, fname) {
  list.fold(m.funcs, [], fn(acc, f) {
    if f.name == fname then
      list.map(f.blocks, fn(b) { { label: b.label, insts: list.len(b.insts) } })
    else acc
  })
}
