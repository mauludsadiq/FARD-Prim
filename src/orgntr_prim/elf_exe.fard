/// elf_exe — ELF64 executable emitter for Linux x86-64
/// Produces a minimal statically-linked ELF binary.
///
/// Layout:
///   0x000000: ELF header (64 bytes)
///   0x000040: Program header - PT_LOAD RX text (56 bytes)
///   0x000078: Program header - PT_LOAD RW data (56 bytes)
///   0x001000: text section (entry stub + alloc stub + code)
///   0x002000: data section (heap bump pointer + heap)

import("std/list") as list
import("std/bits") as bits
import("std/rec")  as rec
import("../orgntr_prim/x86_64_encode") as enc

fn le16(n) { [n % 256, (n / 256) % 256] }
fn le32(n) { enc.le32(n) }
fn le64(n) { enc.le64(n) }
fn zeros(n) { list.build(n, fn(_) { 0 }) }

// ── Memory layout ─────────────────────────────────────────────────────────────

fn load_addr()          { 4194304 }      // 0x400000 — standard Linux base
fn text_file_offset()   { 4096 }         // 0x1000
fn text_vmaddr()        { 4198400 }      // 0x401000
fn data_file_offset()   { 8192 }         // 0x2000
fn data_vmaddr()        { 4202496 }      // 0x402000
fn data_size()          { 4096 }
fn heap_bump_ptr_vmaddr() { 4202496 }    // first 8 bytes of data
fn heap_base_vmaddr()   { 4202504 }      // bump_ptr + 8

// ── ELF header (64 bytes) ─────────────────────────────────────────────────────

fn elf_header(entry_vmaddr, phoff, phnum) {
  list.concat([
    // e_ident (16 bytes)
    [127, 69, 76, 70],   // magic: 0x7f ELF
    [2],                  // EI_CLASS: ELFCLASS64
    [1],                  // EI_DATA: ELFDATA2LSB (little-endian)
    [1],                  // EI_VERSION: EV_CURRENT
    [0],                  // EI_OSABI: ELFOSABI_NONE
    zeros(8),             // EI_ABIVERSION + padding
    // e_type (2): ET_EXEC
    le16(2),
    // e_machine (2): EM_X86_64
    le16(62),
    // e_version (4): EV_CURRENT
    le32(1),
    // e_entry (8): entry point vmaddr
    le64(entry_vmaddr),
    // e_phoff (8): program header offset (right after elf header = 64)
    le64(phoff),
    // e_shoff (8): section header offset (none)
    le64(0),
    // e_flags (4)
    le32(0),
    // e_ehsize (2): size of this header
    le16(64),
    // e_phentsize (2): size of program header entry
    le16(56),
    // e_phnum (2): number of program headers
    le16(phnum),
    // e_shentsize (2)
    le16(64),
    // e_shnum (2)
    le16(0),
    // e_shstrndx (2)
    le16(0)
  ])
}

// ── Program header (56 bytes each) ────────────────────────────────────────────

fn pt_load(flags, offset, vaddr, filesz, memsz, align) {
  list.concat([
    le32(1),          // p_type: PT_LOAD
    le32(flags),      // p_flags: 5=RX, 6=RW
    le64(offset),     // p_offset
    le64(vaddr),      // p_vaddr
    le64(vaddr),      // p_paddr
    le64(filesz),     // p_filesz
    le64(memsz),      // p_memsz
    le64(align)       // p_align
  ])
}

// ── Entry stub (Linux syscalls) ───────────────────────────────────────────────
// push rbp; mov rbp,rsp; call entry_func; mov rdi,rax; mov rax,60; syscall
// Linux exit syscall = 60 (vs macOS 0x2000001)

fn entry_stub_linux(fn_offset) {
  // mmap(0, 64MB, PROT_RW, MAP_PRIVATE|MAP_ANON, -1, 0) -> rbx=heap bump ptr
  // rax=9, rdi=0, rsi=64MB, rdx=3, r10=34, r8=-1, r9=0
  // call is at byte 53, rel = fn_offset - 58
  let rel = fn_offset - 70 in
  list.concat([
    [72, 49, 255],                              // xor rdi,rdi (3)
    [72, 190], le64(67108864),                  // mov rsi,64MB (10)
    [72, 186, 3, 0, 0, 0, 0, 0, 0, 0],          // mov rdx,3 (10)
    [73, 186, 34, 0, 0, 0, 0, 0, 0, 0],         // mov r10,34 (10)
    [73, 184, 255, 255, 255, 255, 255, 255, 255, 255], // mov r8,-1 (10)
    [77, 49, 201],                              // xor r9,r9 (3)
    [72, 184, 9, 0, 0, 0, 0, 0, 0, 0],          // mov rax,9 (10)
    [15, 5],                                    // syscall (2) -> rax=heap
    [72, 137, 195],                             // mov rbx,rax (3) save bump ptr
    [85, 72, 137, 229],                         // push rbp; mov rbp,rsp (4)
    [232], le32(rel),                           // call fn (5)
    [72, 137, 199],                             // mov rdi,rax (3)
    [72, 184, 60, 0, 0, 0, 0, 0, 0, 0],         // mov rax,60 (10)
    [15, 5]                                     // syscall (2)
  ])
}

// fard_alloc(rdi=size) -> rax=old_bump; rbx=new_bump
// mov rax,rbx  (3)
// add rbx,rdi  (3)
// ret          (1)
// = 7 bytes
fn alloc_stub_x86() {
  [[72,137,216], [72,1,251], [195]]
}
fn alloc_stub_size() { 7 }
fn print_stub_offset() { 0 - 7 - enc.str_stdlib_size() - enc.stdlib_size() }         // fard_print offset
fn print_int_stub_offset() { 0 - 7 - enc.str_stdlib_size() - enc.stdlib_size() + 128 } // fard_print_int offset

fn find_func_offset(funcs, name) {
  let found = list.find(funcs, fn(f) { f.name == name }) in
  if rec.has(found, "some") then found.some.base else 0
}

fn patch4(bs, at, val) {
  // Patch 4 bytes at offset `at` with little-endian val
  let b0 = bits.band(val, 255) in
  let b1 = bits.band(bits.bshr(val, 8), 255) in
  let b2 = bits.band(bits.bshr(val, 16), 255) in
  let b3 = bits.band(bits.bshr(val, 24), 255) in
  let pre  = list.take(bs, at) in
  let post = list.drop(bs, at + 4) in
  list.concat([pre, [b0, b1, b2, b3], post])
}

fn linux_str_concat() { [85, 72, 137, 229, 65, 84, 65, 85, 65, 86, 65, 87, 73, 137, 244, 73, 137, 213, 76, 139, 54, 76, 139, 58, 76, 137, 247, 76, 1, 255, 72, 255, 199, 72, 193, 231, 3, 232, 1, 1, 0, 0, 76, 137, 241, 76, 1, 249, 72, 137, 8, 73, 137, 195, 72, 49, 255, 77, 133, 246, 116, 18, 73, 139, 76, 252, 8, 73, 137, 76, 251, 8, 72, 255, 199, 73, 57, 254, 124, 238, 72, 49, 246, 77, 133, 255, 116, 24, 76, 137, 240, 72, 1, 240, 73, 139, 76, 245, 8, 73, 137, 76, 195, 8, 72, 255, 198, 73, 57, 247, 124, 232, 76, 137, 216, 65, 95, 65, 94, 65, 93, 65, 92, 93, 195] }
fn linux_int_to_str() { [85, 72, 137, 229, 65, 84, 65, 85, 65, 86, 65, 87, 83, 72, 131, 236, 40, 73, 137, 244, 77, 49, 237, 77, 49, 246, 77, 133, 228, 121, 9, 77, 247, 220, 73, 255, 198, 77, 133, 228, 117, 13, 198, 69, 216, 48, 73, 255, 197, 235, 30, 77, 133, 228, 116, 26, 76, 137, 224, 72, 49, 210, 73, 186, 10, 0, 0, 0, 0, 0, 0, 0, 73, 247, 242, 73, 137, 196, 128, 194, 48, 66, 136, 84, 45, 216, 73, 255, 197, 235, 216, 77, 133, 246, 116, 8, 66, 198, 68, 45, 216, 45, 73, 255, 197, 76, 137, 239, 72, 255, 199, 72, 193, 231, 3, 232, 54, 0, 0, 0, 76, 137, 40, 77, 49, 255, 77, 133, 237, 116, 23, 77, 137, 233, 77, 41, 249, 73, 255, 201, 66, 15, 182, 84, 45, 216, 74, 137, 84, 248, 8, 73, 255, 199, 77, 57, 253, 127, 228, 72, 131, 196, 40, 91, 65, 95, 65, 94, 65, 93, 65, 92, 93, 195] }
fn linux_str_stub_size() { 299 }  // str_concat(125) + int_to_str(174)

fn build_text(linked, entry_func) {
  let stub_size = 85 in
  let alloc_stub = list.flatten(alloc_stub_x86()) in
  // Layout: entry(85) + print(285) + str_concat(125) + int_to_str(174) + alloc(7) + functions
  let fn_offset = stub_size + enc.stdlib_size() + linux_str_stub_size() + alloc_stub_size() + find_func_offset(linked.funcs, entry_func) in
  let entry_stub = entry_stub_linux(fn_offset) in
  let print_stubs = list.flatten([enc.fard_print_stub(), enc.fard_print_int_stub()]) in
  // Linux-native str_concat and int_to_str stubs with correct alloc call offsets
  let linux_stubs = list.concat([linux_str_concat(), linux_int_to_str()]) in
  list.concat([entry_stub, print_stubs, linux_stubs, alloc_stub, linked.text])
}

// ── Data section ──────────────────────────────────────────────────────────────
// 8 bytes: heap bump pointer (initialized to heap_base_vmaddr)
// rest: zeroed heap space

fn build_data() {
  zeros(data_size())
}

// ── Padding ───────────────────────────────────────────────────────────────────

fn pad_to(bytes, target) {
  let n = list.len(bytes) in
  if n >= target then bytes
  else list.concat([bytes, zeros(target - n)])
}

// ── Main emitter ──────────────────────────────────────────────────────────────

fn emit_exe(linked, entry_func) {
  let text = build_text(linked, entry_func) in
  let text_size = list.len(text) in
  let data = build_data() in

  // Entry point = text_vmaddr (entry stub is first)
  let entry_vmaddr = text_vmaddr() in
  let phoff = 64 in
  let phnum = 2 in

  let ehdr = elf_header(entry_vmaddr, phoff, phnum) in

  // First PT_LOAD: offset 0, covers entire first page (header + text)
  // vaddr = load_addr() = 0x400000, maps from file offset 0
  // text starts at file offset 0x1000 = vaddr 0x401000
  let first_load_size = text_file_offset() + text_size in
  let phdr_text = pt_load(5, 0, load_addr(), first_load_size, first_load_size, 4096) in

  // Second PT_LOAD: data (RW = 6)
  let phdr_data = pt_load(6, data_file_offset(), data_vmaddr(),
    data_size(), data_size(), 4096) in

  // File layout: [header+phdrs padded to 0x1000][text][pad to 0x2000][data]
  let header_section = list.concat([ehdr, phdr_text, phdr_data]) in
  let padded_header = pad_to(header_section, text_file_offset()) in
  let padded_text = pad_to(list.concat([padded_header, text]), data_file_offset()) in
  list.concat([padded_text, data])
}

export { emit_exe, text_vmaddr, heap_bump_ptr_vmaddr, heap_base_vmaddr }
