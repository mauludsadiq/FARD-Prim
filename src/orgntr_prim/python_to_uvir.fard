/// python_to_uvir — lowers Python JSON AST to UVIR
/// Uses Python's ast module output (via py_to_json.py bridge).
/// Subset: integers, bools, None, arithmetic, comparisons,
///         variables, if/else, while, def, return, call, list, subscript

import("std/list")  as list
import("std/rec")   as rec
import("std/str")   as str
import("std/type")  as type
import("std/array") as array
import("../orgntr_prim/uvir") as uvir

fn make_ctx(fn_names) {
  { next_reg: array.from_list([0]), fn_names: fn_names,
    lifted_fns: array.from_list([]),
    class_defs: array.from_list([{}]) }
}

fn ctx_register_class(ctx, name, fields, methods) {
  let cd = array.get(ctx.class_defs, 0) in
  let _ = array.set(ctx.class_defs, 0, rec.set(cd, name, { fields: fields, methods: methods })) in
  0
}

fn ctx_get_class(ctx, name) {
  let cd = array.get(ctx.class_defs, 0) in
  if rec.has(cd, name) then rec.get(cd, name) else null
}

fn class_field_idx(fields, name) {
  list.fold(list.build(list.len(fields), fn(i){i}), -1, fn(acc, i) {
    if acc >= 0 then acc
    else if list.get(fields, i) == name then i
    else -1
  })
}

fn collect_self_fields(stmts) {
  // Collect field names from self.X = ... assignments in __init__
  list.fold(stmts, [], fn(acc, stmt) {
    if stmt.t != "Assign" then acc
    else
      let targets = stmt.targets in
      if list.len(targets) == 0 then acc
      else
        let tgt = list.get(targets, 0) in
        if tgt.t != "Attribute" then acc
        else if tgt.value.t != "Name" then acc
        else if tgt.value.id != "self" then acc
        else if list.any(acc, fn(f){ f == tgt.attr }) then acc
        else list.append(acc, tgt.attr)
  })
}
fn alloc_reg(ctx) {
  let r = array.get(ctx.next_reg, 0) in
  let _ = array.set(ctx.next_reg, 0, r + 1) in r
}
fn alloc_label(ctx) {
  let r = array.get(ctx.next_reg, 0) in
  let _ = array.set(ctx.next_reg, 0, r + 1) in r
}
fn env_empty() { null }
fn env_set(env, name, reg) { { name: name, reg: reg, next: env } }
fn env_get(env, name) {
  if env == null then null
  else if env.name == name then env.reg
  else env_get(env.next, name)
}
fn make_bb(label) { { label: label, insts: [] } }
fn bb_emit(bb, inst) { { label: bb.label, insts: list.append(bb.insts, inst) } }
fn bb_finish(bb, term) { uvir.block(bb.label, bb.insts, term) }

fn py_op_to_uvir(op) {
  let t = op.t in
  if t == "Add"      then "+"
  else if t == "Sub" then "-"
  else if t == "Mult" then "*"
  else if t == "FloorDiv" then "/"
  else if t == "Mod"  then "%"
  else if t == "Eq"   then "=="
  else if t == "NotEq" then "!="
  else if t == "Lt"   then "<"
  else if t == "LtE"  then "<="
  else if t == "Gt"   then ">"
  else if t == "GtE"  then ">="
  else "+"
}

// Lower a Python expression node -> { reg, bb, extra }
fn lower_expr(node, env, bb, ctx) {
  let t = node.t in
  if t == "Constant" then
    let dst = alloc_reg(ctx) in
    let v = node.value in
    let ins = if type.of(v) == "int" then uvir.inst_const(dst, uvir.val_int(v))
      else if type.of(v) == "bool" then uvir.inst_const(dst, uvir.val_bool(v))
      else if type.of(v) == "string" || type.of(v) == "text" then uvir.inst_str_const(dst, v)
      else if v == null then uvir.inst_const(dst, uvir.val_null())
      else uvir.inst_const(dst, uvir.val_int(0)) in
    { reg: dst, bb: bb_emit(bb, ins), extra: [] }
  else if t == "Name" then
    let vr = env_get(env, node.id) in
    if vr != null then { reg: vr, bb: bb, extra: [] }
    else let dst = alloc_reg(ctx) in
      { reg: dst, bb: bb_emit(bb, uvir.inst_const(dst, uvir.val_int(0))), extra: [] }
  else if t == "BinOp" then
    let lv = lower_expr(node.left, env, bb, ctx) in
    let rv = lower_expr(node.right, env, lv.bb, ctx) in
    let dst = alloc_reg(ctx) in
    let op = py_op_to_uvir(node.op) in
    let ins = if op == "+" then uvir.inst_int_add(dst, lv.reg, rv.reg)
      else if op == "-" then uvir.inst_int_sub(dst, lv.reg, rv.reg)
      else if op == "*" then uvir.inst_int_mul(dst, lv.reg, rv.reg)
      else if op == "/" then uvir.inst_int_div(dst, lv.reg, rv.reg)
      else if op == "%" then uvir.inst_int_mod(dst, lv.reg, rv.reg)
      else uvir.inst_int_add(dst, lv.reg, rv.reg) in
    { reg: dst, bb: bb_emit(rv.bb, ins), extra: list.concat([lv.extra, rv.extra]) }
  else if t == "Compare" then
    let lv = lower_expr(node.left, env, bb, ctx) in
    // Single comparator for subset
    let op = if list.len(node.ops) > 0 then py_op_to_uvir(list.get(node.ops, 0)) else "==" in
    let cv = if list.len(node.comparators) > 0
      then lower_expr(list.get(node.comparators, 0), env, lv.bb, ctx)
      else { reg: lv.reg, bb: lv.bb, extra: [] } in
    let dst = alloc_reg(ctx) in
    { reg: dst, bb: bb_emit(cv.bb, uvir.inst_int_cmp(dst, op, lv.reg, cv.reg)),
      extra: list.concat([lv.extra, cv.extra]) }
  else if t == "UnaryOp" then
    let v = lower_expr(node.operand, env, bb, ctx) in
    let dst = alloc_reg(ctx) in
    // -x = 0 - x
    let z = alloc_reg(ctx) in
    let b1 = bb_emit(v.bb, uvir.inst_const(z, uvir.val_int(0))) in
    { reg: dst, bb: bb_emit(b1, uvir.inst_int_sub(dst, z, v.reg)), extra: v.extra }
  else if t == "Call" then
    let ar = list.fold(node.args, { regs: [], bb: bb, extra: [] }, fn(acc, arg) {
      let r = lower_expr(arg, env, acc.bb, ctx) in
      { regs: list.append(acc.regs, r.reg), bb: r.bb, extra: list.concat([acc.extra, r.extra]) }
    }) in
    let dst = alloc_reg(ctx) in
    let fn_name = if node.func.t == "Name" then node.func.id else "__unknown__" in
    if fn_name == "len" then
      let lst = list.get(ar.regs, 0) in
      let dst2 = alloc_reg(ctx) in
      { reg: dst2, bb: bb_emit(ar.bb, uvir.inst_load(dst2, lst, 0)), extra: ar.extra }
    else if fn_name == "dict_get" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "__dict_get__", ar.regs)), extra: ar.extra }
    else if fn_name == "dict_set" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "__dict_set__", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_open" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_open", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_read" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_read", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_write" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_write", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_close" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_close", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_lseek" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_lseek", ar.regs)), extra: ar.extra }
    else if fn_name == "fs_unlink" then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, "fard_fs_unlink", ar.regs)), extra: ar.extra }
    else if list.any(ctx.fn_names, fn(n) { n == fn_name }) then
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, fn_name, ar.regs)), extra: ar.extra }
    else if ctx_get_class(ctx, fn_name) != null then
      // Class instantiation: call constructor
      { reg: dst, bb: bb_emit(ar.bb, uvir.inst_call_direct(dst, fn_name, ar.regs)), extra: ar.extra }
    else if node.func.t == "Attribute" then
      // Method call: obj.method(args) -> ClassName__method(obj, args)
      let obj = lower_expr(node.func.value, env, ar.bb, ctx) in
      let var_name2 = if node.func.value.t == "Name" then node.func.value.id else "" in
      let type_key2 = str.concat(["__type__", var_name2]) in
      let tracked2 = env_get(env, type_key2) in
      let class_name = if tracked2 != null then tracked2
        else if ctx_get_class(ctx, var_name2) != null then var_name2
        else "" in
      let cls = ctx_get_class(ctx, class_name) in
      let method_fn = if cls != null then
        if rec.has(cls.methods, node.func.attr)
          then rec.get(cls.methods, node.func.attr)
          else "__unknown__"
        else "__unknown__" in
      let attr_name = node.func.attr in
      if attr_name == "append" then
        let v_reg = if list.len(ar.regs) > 0 then list.get(ar.regs, 0) else 0 in
        { reg: dst, bb: bb_emit(obj.bb, uvir.inst_call_direct(dst, "__list_append__", [obj.reg, v_reg])),
          extra: list.concat([ar.extra, obj.extra]) }
      else if attr_name == "pop" then
        { reg: dst, bb: bb_emit(obj.bb, uvir.inst_call_direct(dst, "__list_pop__", [obj.reg])),
          extra: list.concat([ar.extra, obj.extra]) }
      else
        let all_args = list.concat([[obj.reg], ar.regs]) in
        { reg: dst, bb: bb_emit(obj.bb, uvir.inst_call_direct(dst, method_fn, all_args)),
          extra: list.concat([ar.extra, obj.extra]) }
    else
      let fr = lower_expr(node.func, env, ar.bb, ctx) in
      { reg: dst, bb: bb_emit(fr.bb, uvir.inst_call_indirect(dst, fr.reg, ar.regs)),
        extra: list.concat([ar.extra, fr.extra]) }
  else if t == "List" then
    let ir = list.fold(node.elts, { regs: [], bb: bb, extra: [] }, fn(acc, elt) {
      let r = lower_expr(elt, env, acc.bb, ctx) in
      { regs: list.append(acc.regs, r.reg), bb: r.bb, extra: list.concat([acc.extra, r.extra]) }
    }) in
    let dst = alloc_reg(ctx) in
    let pr = 10000 + dst in
    let n = list.len(node.elts) in
    let lr = 10001 + dst in
    let b0 = bb_emit(ir.bb, uvir.inst_alloc(pr, (1 + n + 8) * 8, "list")) in
    let b1 = bb_emit(b0, uvir.inst_const(lr, uvir.val_int(n))) in
    let b2 = bb_emit(b1, uvir.inst_store(pr, 0, lr)) in
    let b3 = list.fold(list.build(n, fn(i) { i }), b2, fn(bk, i) {
      bb_emit(bk, uvir.inst_store(pr, 8 + i * 8, list.get(ir.regs, i)))
    }) in
    { reg: dst, bb: bb_emit(b3, uvir.inst_copy(dst, pr)), extra: ir.extra }
  else if t == "Subscript" then
    let ob = lower_expr(node.value, env, bb, ctx) in
    let ix = lower_expr(node.slice, env, ob.bb, ctx) in
    let dst = alloc_reg(ctx) in
    // Check if this is a string-keyed dict access
    let slice_is_str = if node.slice.t == "Constant" then
      type.of(node.slice.value) == "text" || type.of(node.slice.value) == "string"
      else false in
    if slice_is_str then
      { reg: dst, bb: bb_emit(ix.bb, uvir.inst_call_direct(dst, "__dict_get__",
          [ob.reg, ix.reg])),
        extra: list.concat([ob.extra, ix.extra]) }
    else
      { reg: dst, bb: bb_emit(ix.bb, uvir.inst_load_dyn(dst, ob.reg, ix.reg)),
        extra: list.concat([ob.extra, ix.extra]) }
  else if t == "IfExp" then
    // Ternary: a if cond else b
    let cr = lower_expr(rec.get(node, "test"), env, bb, ctx) in
    let lt = alloc_label(ctx) in
    let lf = alloc_label(ctx) in
    let lj = alloc_label(ctx) in
    let cb = bb_finish(cr.bb, uvir.term_br_cond(cr.reg, lt, lf)) in
    let tb = make_bb(lt) in
    let tr = lower_expr(node.body, env, tb, ctx) in
    let tblk = bb_finish(tr.bb, uvir.term_br(lj)) in
    let fb = make_bb(lf) in
    let fr = lower_expr(node.orelse, env, fb, ctx) in
    let fblk = bb_finish(fr.bb, uvir.term_br(lj)) in
    let jd = alloc_reg(ctx) in
    let phi = uvir.inst_phi(jd, [{ from_label: lt, reg: tr.reg }, { from_label: lf, reg: fr.reg }]) in
    let jb = bb_emit(make_bb(lj), phi) in
    let xa = list.concat([cr.extra, [cb, tblk]]) in
    let xb = list.concat([tr.extra, [fblk]]) in
    { reg: jd, bb: jb, extra: list.concat([xa, xb, fr.extra]) }
  else if t == "Attribute" then
    // self.field or obj.field load
    let obj = lower_expr(node.value, env, bb, ctx) in
    let dst = alloc_reg(ctx) in
    // Look up field index from class registry via env type tracking
    // Conservative: use dynamic field name lookup via stored field index
    // We embed the field name as a compile-time string constant and use
    // a field_idx helper - for now use a static offset via class registry
    let var_name = if rec.has(node.value, "id") then node.value.id else "" in
    let type_key = str.concat(["__type__", var_name]) in
    let tracked_class = env_get(env, type_key) in
    let class_name = if tracked_class != null then tracked_class
      else if ctx_get_class(ctx, var_name) != null then var_name
      else "" in
    let cls = ctx_get_class(ctx, class_name) in
    let field_idx = if cls != null then class_field_idx(cls.fields, node.attr) else -1 in
    if field_idx >= 0 then
      { reg: dst, bb: bb_emit(obj.bb, uvir.inst_load(dst, obj.reg, (field_idx + 1) * 8)),
        extra: obj.extra }
    else
      // Unknown class or field - emit 0
      { reg: dst, bb: bb_emit(obj.bb, uvir.inst_const(dst, uvir.val_int(0))), extra: obj.extra }
  else if t == "Dict" then
    // Dict literal: allocate heap record [n_keys, key0, val0, key1, val1, ...]
    let n = list.len(node.keys) in
    let size = (1 + n * 2) * 8 in
    let dst = alloc_reg(ctx) in
    let hdr_r = alloc_reg(ctx) in
    let all_kv = list.build(n, fn(i){i}) in
    // Lower all keys and values
    let kv_result = list.fold(all_kv, { regs: [], bb: bb, extra: [] }, fn(acc2, i) {
      let k = lower_expr(list.get(node.keys, i), env, acc2.bb, ctx) in
      let v = lower_expr(list.get(node.values, i), env, k.bb, ctx) in
      { regs: list.append(list.append(acc2.regs, k.reg), v.reg),
        bb: v.bb, extra: list.concat([acc2.extra, k.extra, v.extra]) }
    }) in
    let b0 = bb_emit(kv_result.bb, uvir.inst_alloc(dst, size, "dict")) in
    let b1 = bb_emit(b0, uvir.inst_const(hdr_r, uvir.val_int(n))) in
    let b2 = bb_emit(b1, uvir.inst_store(dst, 0, hdr_r)) in
    // Store key-value pairs
    let b3 = list.fold(all_kv, b2, fn(bk, i) {
      let k_reg = list.get(kv_result.regs, i * 2) in
      let v_reg = list.get(kv_result.regs, i * 2 + 1) in
      let bk2 = bb_emit(bk, uvir.inst_store(dst, (1 + i * 2) * 8, k_reg)) in
      bb_emit(bk2, uvir.inst_store(dst, (2 + i * 2) * 8, v_reg))
    }) in
    { reg: dst, bb: b3, extra: kv_result.extra }
  else
    let dst = alloc_reg(ctx) in
    { reg: dst, bb: bb_emit(bb, uvir.inst_const(dst, uvir.val_int(0))), extra: [] }
}

// Lower a list of Python statements -> { bb, extra, env, ret_reg }
// ret_reg: if a return was encountered
fn collect_assigned_names(stmts) {
  list.flatten(list.map(stmts, fn(stmt) {
    if stmt.t == "Assign" then
      if list.len(stmt.targets) > 0 && list.get(stmt.targets, 0).t == "Name"
        then [list.get(stmt.targets, 0).id]
        else []
    else if stmt.t == "AugAssign" then
      if stmt.target.t == "Name" then [stmt.target.id] else []
    else []
  }))
}

fn lower_stmts(stmts, env, bb, ctx) {
  list.fold(stmts, { bb: bb, extra: [], env: env, ret_reg: null }, fn(acc, stmt) {
    if acc.ret_reg != null then acc else
    let t = stmt.t in
    if t == "Return" then
      let v = if stmt.value != null
        then lower_expr(stmt.value, acc.env, acc.bb, ctx)
        else { reg: alloc_reg(ctx), bb: bb_emit(acc.bb, uvir.inst_const(alloc_reg(ctx), uvir.val_null())), extra: [] } in
      { bb: v.bb, extra: list.concat([acc.extra, v.extra]),
        env: env_set(acc.env, "__last_expr__", v.reg), ret_reg: null }
    else if t == "Assign" then
      let v = lower_expr(stmt.value, acc.env, acc.bb, ctx) in
      let tgt = if list.len(stmt.targets) > 0 then list.get(stmt.targets, 0) else { t: "Name", id: "__anon__" } in
      if tgt.t == "Subscript" then
        // dict/list assignment: d[key] = val
        let obj = lower_expr(tgt.value, acc.env, v.bb, ctx) in
        let key = lower_expr(tgt.slice, acc.env, obj.bb, ctx) in
        let obj_name = if tgt.value.t == "Name" then tgt.value.id else "" in
        let tracked_type = env_get(acc.env, str.concat(["__type__", obj_name])) in
        let nb = if tracked_type == "__list__" then
          bb_emit(key.bb, uvir.inst_store_dyn(obj.reg, key.reg, v.reg))
        else
          let ret_r = alloc_reg(ctx) in
          bb_emit(key.bb, uvir.inst_call_direct(ret_r, "__dict_set__",
            [obj.reg, key.reg, v.reg])) in
        { bb: nb, extra: list.concat([acc.extra, v.extra, obj.extra, key.extra]),
          env: acc.env, ret_reg: null }
      else if tgt.t == "Attribute" then
        // self.field = val
        let obj = lower_expr(tgt.value, acc.env, v.bb, ctx) in
        let class_name = if tgt.value.t == "Name" then tgt.value.id else "" in
        let cls = ctx_get_class(ctx, class_name) in
        let field_idx = if cls != null then class_field_idx(cls.fields, tgt.attr) else -1 in
        let offset = (field_idx + 1) * 8 in
        let nb = bb_emit(obj.bb, uvir.inst_store(obj.reg, offset, v.reg)) in
        { bb: nb, extra: list.concat([acc.extra, v.extra, obj.extra]), env: acc.env, ret_reg: null }
      else
        let name = if tgt.t == "Name" then tgt.id else "__anon__" in
        let class_type = if stmt.value.t == "Dict" then "__dict__"
          else if stmt.value.t == "List" then "__list__"
          else if stmt.value.t == "Call" then
            if stmt.value.func.t == "Name" then
              if ctx_get_class(ctx, stmt.value.func.id) != null then stmt.value.func.id else ""
            else ""
          else "" in
        let env2 = env_set(acc.env, name, v.reg) in
        let env3 = if class_type != ""
          then env_set(env2, str.concat(["__type__", name]), class_type)
          else env2 in
        { bb: v.bb, extra: list.concat([acc.extra, v.extra]), env: env3, ret_reg: null }
    else if t == "AugAssign" then
      // x += expr => x = x + expr
      let name = if stmt.target.t == "Name" then stmt.target.id else "__anon__" in
      let lv = lower_expr(stmt.target, acc.env, acc.bb, ctx) in
      let rv = lower_expr(stmt.value, acc.env, lv.bb, ctx) in
      let dst = alloc_reg(ctx) in
      let op = py_op_to_uvir(stmt.op) in
      let ins = if op == "+" then uvir.inst_int_add(dst, lv.reg, rv.reg)
        else if op == "-" then uvir.inst_int_sub(dst, lv.reg, rv.reg)
        else if op == "*" then uvir.inst_int_mul(dst, lv.reg, rv.reg)
        else uvir.inst_int_add(dst, lv.reg, rv.reg) in
      let nb = bb_emit(rv.bb, ins) in
      { bb: nb, extra: list.concat([acc.extra, lv.extra, rv.extra]),
        env: env_set(acc.env, name, dst), ret_reg: null }
    else if t == "If" then
      let cr = lower_expr(rec.get(stmt, "test"), acc.env, acc.bb, ctx) in
      let lt = alloc_label(ctx) in
      let lf = alloc_label(ctx) in
      let lj = alloc_label(ctx) in
      let cb = bb_finish(cr.bb, uvir.term_br_cond(cr.reg, lt, lf)) in
      // Then branch
      let tb = make_bb(lt) in
      let tr = lower_stmts(stmt.body, acc.env, tb, ctx) in
      // If then-branch returns, emit Ret; else branch to join
      let tblk = if tr.ret_reg != null
        then bb_finish(tr.bb, uvir.term_ret(tr.ret_reg))
        else bb_finish(tr.bb, uvir.term_br(lj)) in
      // Else branch
      let fb = make_bb(lf) in
      let or_stmts = if rec.has(stmt, "orelse") then stmt.orelse else [] in
      let fr = lower_stmts(or_stmts, acc.env, fb, ctx) in
      // If else-branch returns, emit Ret; else branch to join
      let fblk = if fr.ret_reg != null
        then bb_finish(fr.bb, uvir.term_ret(fr.ret_reg))
        else bb_finish(fr.bb, uvir.term_br(lj)) in
      let jb = make_bb(lj) in
      let extra = list.concat([acc.extra, cr.extra, [cb, tblk], tr.extra, [fblk], fr.extra]) in
      // Phi only if NEITHER branch returned (both flow to join)
      let phi_ret = if tr.ret_reg == null && fr.ret_reg != null
        then { jb: jb, reg: fr.ret_reg }  // only else returned -- unusual
        else if tr.ret_reg != null && fr.ret_reg == null
        then { jb: jb, reg: null }  // only then returned
        else { jb: jb, reg: null } in
      let ret = null in
      let final_jb = phi_ret.jb in
      { bb: final_jb, extra: extra, env: acc.env, ret_reg: ret }
    else if t == "While" then
      // Heap-cell pattern for mutable vars — same as For loop
      let body_mut = collect_assigned_names(stmt.body) in
      let lifted = list.filter(body_mut, fn(n) { env_get(acc.env, n) != null }) in
      // Allocate cells for lifted vars, store initial values
      let lifted_cells = list.fold(lifted, { bb: acc.bb, cells: {} }, fn(lc, n) {
        let cell = alloc_reg(ctx) in
        let init_r = env_get(acc.env, n) in
        let b = bb_emit(lc.bb, uvir.inst_alloc(cell, 8, "while_var")) in
        let b2 = if init_r != null then bb_emit(b, uvir.inst_store(cell, 0, init_r))
          else let z = alloc_reg(ctx) in
               let bz = bb_emit(b, uvir.inst_const(z, uvir.val_int(0))) in
               bb_emit(bz, uvir.inst_store(cell, 0, z)) in
        { bb: b2, cells: rec.set(lc.cells, n, cell) }
      }) in
      let loop_label = alloc_label(ctx) in
      let body_label = alloc_label(ctx) in
      let exit_label = alloc_label(ctx) in
      let entry_block = bb_finish(lifted_cells.bb, uvir.term_br(loop_label)) in
      // Loop header: load cells into fresh regs, check condition
      let lbb = make_bb(loop_label) in
      let loop_load = list.fold(lifted, { bb: lbb, env: acc.env }, fn(acc2, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let loaded = alloc_reg(ctx) in
        let nb = bb_emit(acc2.bb, uvir.inst_load(loaded, cell, 0)) in
        { bb: nb, env: env_set(acc2.env, n, loaded) }
      }) in
      let loop_env = loop_load.env in
      let cr = lower_expr(rec.get(stmt, "test"), loop_env, loop_load.bb, ctx) in
      let cond_block = bb_finish(cr.bb, uvir.term_br_cond(cr.reg, body_label, exit_label)) in
      // Body: use loop_env, store updated vars back to cells
      let body_bb = make_bb(body_label) in
      let br = lower_stmts(stmt.body, loop_env, body_bb, ctx) in
      let store_back = list.fold(lifted, br.bb, fn(lb, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let new_r = env_get(br.env, n) in
        if new_r != null then bb_emit(lb, uvir.inst_store(cell, 0, new_r)) else lb
      }) in
      let body_block = bb_finish(store_back, uvir.term_br(loop_label)) in
      // Exit: load final values from cells
      let exit_bb = make_bb(exit_label) in
      let exit_result = list.fold(lifted, { bb: exit_bb, env: acc.env }, fn(el, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let final_r = alloc_reg(ctx) in
        let b = bb_emit(el.bb, uvir.inst_load(final_r, cell, 0)) in
        { bb: b, env: env_set(el.env, n, final_r) }
      }) in
      let extra = list.concat([acc.extra, [entry_block, cond_block, body_block], br.extra, cr.extra]) in
      { bb: exit_result.bb, extra: extra, env: exit_result.env, ret_reg: null }
    else if t == "Expr" then
      // Expression statement -- track result in case it is the last statement
      let v = lower_expr(stmt.value, acc.env, acc.bb, ctx) in
      { bb: v.bb, extra: list.concat([acc.extra, v.extra]),
        env: env_set(acc.env, "__last_expr__", v.reg), ret_reg: null }
    else if t == "For" then
      let target_name = if stmt.target.t == "Name" then stmt.target.id else "__iter__" in
      let iter_node = stmt.iter in
      let is_range = if iter_node.t == "Call" then
        if iter_node.func.t == "Name" then iter_node.func.id == "range" else false
        else false in
      let body_mut = collect_assigned_names(stmt.body) in
      let lifted = list.filter(body_mut, fn(n) { env_get(acc.env, n) != null }) in
      let stop_v_r = alloc_reg(ctx) in
      let iter_v_r = alloc_reg(ctx) in
      let setup_bb = if is_range then
        let rargs = iter_node.args in
        if list.len(rargs) == 1 then
          let sv = lower_expr(list.get(rargs, 0), acc.env, acc.bb, ctx) in
          bb_emit(sv.bb, uvir.inst_copy(stop_v_r, sv.reg))
        else
          let av = lower_expr(list.get(rargs, 0), acc.env, acc.bb, ctx) in
          let bv = lower_expr(list.get(rargs, 1), acc.env, av.bb, ctx) in
          bb_emit(bv.bb, uvir.inst_copy(stop_v_r, bv.reg))
      else
        let iv = lower_expr(iter_node, acc.env, acc.bb, ctx) in
        let lr = alloc_reg(ctx) in
        let b1 = bb_emit(iv.bb, uvir.inst_str_len(lr, iv.reg)) in
        let b2 = bb_emit(b1, uvir.inst_copy(stop_v_r, lr)) in
        bb_emit(b2, uvir.inst_copy(iter_v_r, iv.reg))
      in
      let idx_cell = alloc_reg(ctx) in
      let stop_cell = alloc_reg(ctx) in
      let iter_cell = alloc_reg(ctx) in
      let zero_r = alloc_reg(ctx) in
      let b1 = bb_emit(setup_bb, uvir.inst_alloc(idx_cell, 8, "for_idx")) in
      let b2 = bb_emit(b1, uvir.inst_alloc(stop_cell, 8, "for_stop")) in
      let b3 = bb_emit(b2, uvir.inst_alloc(iter_cell, 8, "for_iter")) in
      let b4 = bb_emit(b3, uvir.inst_const(zero_r, uvir.val_int(0))) in
      let b5 = bb_emit(b4, uvir.inst_store(idx_cell, 0, zero_r)) in
      let b6 = bb_emit(b5, uvir.inst_store(stop_cell, 0, stop_v_r)) in
      let b7 = bb_emit(b6, uvir.inst_store(iter_cell, 0, iter_v_r)) in
      let lifted_cells = list.fold(lifted, { bb: b7, cells: {} }, fn(lc, n) {
        let cell = alloc_reg(ctx) in
        let init_r = env_get(acc.env, n) in
        let b = bb_emit(lc.bb, uvir.inst_alloc(cell, 8, "for_var")) in
        let b2 = if init_r != null then bb_emit(b, uvir.inst_store(cell, 0, init_r))
          else let z = alloc_reg(ctx) in
               let bz = bb_emit(b, uvir.inst_const(z, uvir.val_int(0))) in
               bb_emit(bz, uvir.inst_store(cell, 0, z)) in
        { bb: b2, cells: rec.set(lc.cells, n, cell) }
      }) in
      let loop_label = alloc_label(ctx) in
      let body_label = alloc_label(ctx) in
      let exit_label = alloc_label(ctx) in
      let entry_blk = bb_finish(lifted_cells.bb, uvir.term_br(loop_label)) in
      let lbb = make_bb(loop_label) in
      let cur_idx = alloc_reg(ctx) in
      let cur_stop = alloc_reg(ctx) in
      let lbb = bb_emit(lbb, uvir.inst_load(cur_idx, idx_cell, 0)) in
      let lbb = bb_emit(lbb, uvir.inst_load(cur_stop, stop_cell, 0)) in
      let cond_r = alloc_reg(ctx) in
      let lbb = bb_emit(lbb, uvir.inst_int_cmp(cond_r, "<", cur_idx, cur_stop)) in
      let cond_blk = bb_finish(lbb, uvir.term_br_cond(cond_r, body_label, exit_label)) in
      let bbb = make_bb(body_label) in
      let elem_r = alloc_reg(ctx) in
      let cur_iter = alloc_reg(ctx) in
      let bbb = if is_range then
        bb_emit(bbb, uvir.inst_copy(elem_r, cur_idx))
      else
        let bi = bb_emit(bbb, uvir.inst_load(cur_iter, iter_cell, 0)) in
        bb_emit(bi, uvir.inst_load_dyn(elem_r, cur_iter, cur_idx))
      in
      let cell_loads = list.fold(lifted, { bb: bbb, env: acc.env }, fn(cl, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let loaded = alloc_reg(ctx) in
        let b = bb_emit(cl.bb, uvir.inst_load(loaded, cell, 0)) in
        { bb: b, env: env_set(cl.env, n, loaded) }
      }) in
      let body_env = env_set(cell_loads.env, target_name, elem_r) in
      let br = lower_stmts(stmt.body, body_env, cell_loads.bb, ctx) in
      let store_back = list.fold(lifted, br.bb, fn(lb, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let new_r = env_get(br.env, n) in
        if new_r != null then bb_emit(lb, uvir.inst_store(cell, 0, new_r)) else lb
      }) in
      let new_idx = alloc_reg(ctx) in
      let one_r = alloc_reg(ctx) in
      let ib1 = bb_emit(store_back, uvir.inst_const(one_r, uvir.val_int(1))) in
      let ib2 = bb_emit(ib1, uvir.inst_int_add(new_idx, cur_idx, one_r)) in
      let ib3 = bb_emit(ib2, uvir.inst_store(idx_cell, 0, new_idx)) in
      let body_blk = bb_finish(ib3, uvir.term_br(loop_label)) in
      let exit_bb = make_bb(exit_label) in
      let exit_result = list.fold(lifted, { bb: exit_bb, env: acc.env }, fn(el, n) {
        let cell = rec.get(lifted_cells.cells, n) in
        let final_r = alloc_reg(ctx) in
        let b = bb_emit(el.bb, uvir.inst_load(final_r, cell, 0)) in
        { bb: b, env: env_set(el.env, n, final_r) }
      }) in
      let extra = list.concat([acc.extra, [entry_blk, cond_blk, body_blk], br.extra]) in
      { bb: exit_result.bb, extra: extra, env: exit_result.env, ret_reg: null }
    else if t == "ClassDef" then
      // Register class layout and generate constructor + methods
      // Find __init__ to collect field names
      let init_methods = list.filter(stmt.body, fn(m){ m.t == "FunctionDef" && m.name == "__init__" }) in
      let fields = if list.len(init_methods) > 0
        then collect_self_fields(list.get(init_methods, 0).body)
        else [] in
      let n_fields = list.len(fields) in
      // Build methods map: method_name -> mangled_name
      let methods = list.fold(stmt.body, {}, fn(mmap, m) {
        if m.t != "FunctionDef" then mmap
        else rec.set(mmap, m.name, str.concat([stmt.name, "__", m.name]))
      }) in
      let _ = ctx_register_class(ctx, stmt.name, fields, methods) in
      acc
    else
      acc
  })
}

fn lower_funcdef(node, fn_names) {
  lower_funcdef_with_ctx(node, make_ctx(fn_names))
}

fn lower_funcdef_with_ctx(node, ctx) {
  let param_names = list.map(node.args.args, fn(a) { a.arg }) in
  let params = list.build(list.len(param_names), fn(i) {
    uvir.param(i, uvir.ty_any(), list.get(param_names, i))
  }) in
  let env = list.fold(list.build(list.len(param_names), fn(i) { i }), env_empty(),
    fn(e, i) { let _ = alloc_reg(ctx) in env_set(e, list.get(param_names, i), i) }) in
  let ebb = make_bb(0) in
  let result = lower_stmts(node.body, env, ebb, ctx) in
  let ret_reg = if result.ret_reg != null then result.ret_reg else
    let r = alloc_reg(ctx) in r in
  let fblk = bb_finish(result.bb, uvir.term_ret(ret_reg)) in
  let all_blocks = list.concat([result.extra, [fblk]]) in
  let sorted = list.sort_int(list.map(all_blocks, fn(b) { b.label })) in
  let bmap = list.fold(all_blocks, {}, fn(acc, b) { rec.set(acc, str.from(b.label), b) }) in
  let ordered = list.map(sorted, fn(l) { rec.get(bmap, str.from(l)) }) in
  uvir.func(node.name, params, uvir.ty_any(), ordered, uvir.func_attrs(false, false))
}

fn lower_funcdef_with_class(node, fn_names, parent_ctx, self_class_name, self_fields) {
  // Like lower_funcdef but pre-registers the class and self type in ctx
  let ctx = make_ctx(fn_names) in
  // Copy class registry from parent
  let parent_cd = array.get(parent_ctx.class_defs, 0) in
  let _ = array.set(ctx.class_defs, 0, parent_cd) in
  let param_names = list.map(node.args.args, fn(a) { a.arg }) in
  let params = list.build(list.len(param_names), fn(i) {
    uvir.param(i, uvir.ty_any(), list.get(param_names, i))
  }) in
  let env = list.fold(list.build(list.len(param_names), fn(i) { i }), env_empty(),
    fn(e, i) { let _ = alloc_reg(ctx) in env_set(e, list.get(param_names, i), i) }) in
  // Pre-register self type if first param is "self"
  let env2 = if list.len(param_names) > 0 && list.get(param_names, 0) == "self"
    then env_set(env, "__type__self", self_class_name)
    else env in
  let ebb = make_bb(0) in
  let result = lower_stmts(node.body, env2, ebb, ctx) in
  let ret_reg = if result.ret_reg != null then result.ret_reg else
    let r = alloc_reg(ctx) in r in
  let fblk = bb_finish(result.bb, uvir.term_ret(ret_reg)) in
  let all_blocks = list.concat([result.extra, [fblk]]) in
  let sorted = list.sort_int(list.map(all_blocks, fn(b) { b.label })) in
  let bmap = list.fold(all_blocks, {}, fn(acc, b) { rec.set(acc, str.from(b.label), b) }) in
  let ordered = list.map(sorted, fn(l) { rec.get(bmap, str.from(l)) }) in
  uvir.func(node.name, params, uvir.ty_any(), ordered, uvir.func_attrs(false, false))
}

fn lower_classdef(class_node, all_names, ctx) {
  // Generate constructor ClassName(args...) and methods ClassName__method(self, args...)
  let class_name = class_node.name in
  let cls = ctx_get_class(ctx, class_name) in
  let fields = if cls != null then cls.fields else [] in
  let n_fields = list.len(fields) in

  // Generate methods as regular functions with mangled names
  let method_fns = list.map(
    list.filter(class_node.body, fn(m){ m.t == "FunctionDef" }),
    fn(m) {
      let mangled = str.concat([class_name, "__", m.name]) in
      let renamed = { t: m.t, name: mangled, args: m.args, body: m.body,
                      decorator_list: [], returns: null, type_comment: null } in
      lower_funcdef_with_class(renamed, all_names, ctx, class_name, fields)
    }) in

  // Generate constructor: ClassName__new__(args from __init__ minus self)
  let init_methods = list.filter(class_node.body, fn(m){ m.t == "FunctionDef" && m.name == "__init__" }) in
  let ctor_fn = if list.len(init_methods) > 0 then
    let init = list.get(init_methods, 0) in
    let ctor_params = list.filter(init.args.args, fn(a){ a.arg != "self" }) in
    let ctor_node = { t: "FunctionDef", name: class_name,
                      args: { t: "arguments", args: ctor_params, posonlyargs: [],
                              vararg: null, kwonlyargs: [], kw_defaults: [],
                              kwarg: null, defaults: [] },
                      body: [], decorator_list: [], returns: null, type_comment: null } in
    // Build constructor body in UVIR directly
    let ctx2 = make_ctx(all_names) in
    let n_params = list.len(ctor_params) in
    let params = list.build(n_params, fn(i) {
      uvir.param(i, uvir.ty_any(), list.get(ctor_params, i).arg)
    }) in
    // Advance ctx2 past param regs
    let _ = list.build(n_params, fn(i){ alloc_reg(ctx2) }) in
    let self_reg = n_params in
    let _ = alloc_reg(ctx2) in  // consume reg for self
    let ebb = make_bb(0) in
    let size = (1 + n_fields) * 8 in
    let hdr_reg = alloc_reg(ctx2) in
    let b0 = bb_emit(ebb, uvir.inst_alloc(self_reg, size, class_name)) in
    // Store header (field count)
    let b1 = bb_emit(b0, uvir.inst_const(hdr_reg, uvir.val_int(n_fields))) in
    let b2 = bb_emit(b1, uvir.inst_store(self_reg, 0, hdr_reg)) in
    // Build env with params
    let env = list.fold(list.build(n_params, fn(i){i}), env_empty(),
      fn(e, i) { env_set(e, list.get(ctor_params, i).arg, i) }) in
    let env2 = env_set(env, "self", self_reg) in
    // Register self type for attribute stores
    let _ = ctx_register_class(ctx2, "self", fields, {}) in
    // Lower __init__ body (self.x = val assignments)
    let init_result = lower_stmts(init.body, env2, b2, ctx2) in
    let fblk = bb_finish(init_result.bb, uvir.term_ret(self_reg)) in
    let all_blocks = list.concat([init_result.extra, [fblk]]) in
    let sorted = list.sort_int(list.map(all_blocks, fn(b){ b.label })) in
    let bmap = list.fold(all_blocks, {}, fn(acc, b){ rec.set(acc, str.from(b.label), b) }) in
    let ordered = list.map(sorted, fn(l){ rec.get(bmap, str.from(l)) }) in
    uvir.func(class_name, params, uvir.ty_any(), ordered, uvir.func_attrs(false, false))
  else
    // No __init__: trivial constructor
    let ctx2 = make_ctx(all_names) in
    let self_reg = alloc_reg(ctx2) in
    let hdr_reg = alloc_reg(ctx2) in
    let ebb = make_bb(0) in
    let b0 = bb_emit(ebb, uvir.inst_alloc(self_reg, 8, class_name)) in
    let b1 = bb_emit(b0, uvir.inst_const(hdr_reg, uvir.val_int(0))) in
    let b2 = bb_emit(b1, uvir.inst_store(self_reg, 0, hdr_reg)) in
    let fblk = bb_finish(b2, uvir.term_ret(self_reg)) in
    uvir.func(class_name, [], uvir.ty_any(), [fblk], uvir.func_attrs(false, false))
  in
  list.concat([method_fns, [ctor_fn]])
}

fn build_dict_helpers(fn_names) {
  // __dict_get__(dict_ptr=reg0, key_str=reg1) -> val or 0
  // Dict layout: [n(8), k0(8), v0(8), k1(8), v1(8), ...]
  // LoadHeapDyn(ptr, idx) = ptr[8 + idx*8]
  // So key[i] = LoadHeapDyn(dict, i*2)  (element index i*2, 0-based)
  //    val[i] = LoadHeapDyn(dict, i*2+1)
  // n_entries = LoadHeapDyn(dict, -1)... no, n is at offset 0 = ptr[0]
  // Actually: use inst_load(dst, ptr, 0) to get n (constant offset 0)
  let ctx = make_ctx(fn_names) in
  let _ = alloc_reg(ctx) in  // reg 0: dict_ptr
  let _ = alloc_reg(ctx) in  // reg 1: key_str
  let get_params = [uvir.param(0, uvir.ty_any(), "dict"), uvir.param(1, uvir.ty_any(), "key")] in

  let n_r    = alloc_reg(ctx) in
  let i_cell = alloc_reg(ctx) in
  let zero_r = alloc_reg(ctx) in

  let ebb = make_bb(0) in
  let ebb = bb_emit(ebb, uvir.inst_load(n_r, 0, 0)) in
  let ebb = bb_emit(ebb, uvir.inst_alloc(i_cell, 8, "di")) in
  let ebb = bb_emit(ebb, uvir.inst_const(zero_r, uvir.val_int(0))) in
  let ebb = bb_emit(ebb, uvir.inst_store(i_cell, 0, zero_r)) in
  let lbl_loop = alloc_label(ctx) in
  let lbl_body = alloc_label(ctx) in
  let lbl_exit = alloc_label(ctx) in
  let entry_blk = bb_finish(ebb, uvir.term_br(lbl_loop)) in

  let cur_i  = alloc_reg(ctx) in
  let cond_r = alloc_reg(ctx) in
  let lbb = make_bb(lbl_loop) in
  let lbb = bb_emit(lbb, uvir.inst_load(cur_i, i_cell, 0)) in
  let lbb = bb_emit(lbb, uvir.inst_int_cmp(cond_r, "<", cur_i, n_r)) in
  let cond_blk = bb_finish(lbb, uvir.term_br_cond(cond_r, lbl_body, lbl_exit)) in

  // Body: key_elem_idx = i*2, load key via LoadHeapDyn
  let bbb    = make_bb(lbl_body) in
  let two_r  = alloc_reg(ctx) in
  let kidx_r = alloc_reg(ctx) in
  let vidx_r = alloc_reg(ctx) in
  let one_r  = alloc_reg(ctx) in
  let kptr_r = alloc_reg(ctx) in
  let eq_r   = alloc_reg(ctx) in
  let bbb = bb_emit(bbb, uvir.inst_const(two_r, uvir.val_int(2))) in
  let bbb = bb_emit(bbb, uvir.inst_int_mul(kidx_r, cur_i, two_r)) in
  let bbb = bb_emit(bbb, uvir.inst_const(one_r, uvir.val_int(1))) in
  let bbb = bb_emit(bbb, uvir.inst_int_add(vidx_r, kidx_r, one_r)) in
  let bbb = bb_emit(bbb, uvir.inst_load_dyn(kptr_r, 0, kidx_r)) in
  let bbb = bb_emit(bbb, uvir.inst_call_direct(eq_r, "fard_str_eq", [kptr_r, 1])) in
  let lbl_found = alloc_label(ctx) in
  let lbl_inc   = alloc_label(ctx) in
  let body_blk = bb_finish(bbb, uvir.term_br_cond(eq_r, lbl_found, lbl_inc)) in

  // Found: load val at vidx_r
  let fbb   = make_bb(lbl_found) in
  let val_r = alloc_reg(ctx) in
  let fbb = bb_emit(fbb, uvir.inst_load_dyn(val_r, 0, vidx_r)) in
  let found_blk = bb_finish(fbb, uvir.term_ret(val_r)) in

  // Inc: i++, store, loop
  let ibb   = make_bb(lbl_inc) in
  let one2  = alloc_reg(ctx) in
  let new_i = alloc_reg(ctx) in
  let ibb = bb_emit(ibb, uvir.inst_const(one2, uvir.val_int(1))) in
  let ibb = bb_emit(ibb, uvir.inst_int_add(new_i, cur_i, one2)) in
  let ibb = bb_emit(ibb, uvir.inst_store(i_cell, 0, new_i)) in
  let inc_blk = bb_finish(ibb, uvir.term_br(lbl_loop)) in

  // Exit: return 0
  let xbb = make_bb(lbl_exit) in
  let z_r = alloc_reg(ctx) in
  let xbb = bb_emit(xbb, uvir.inst_const(z_r, uvir.val_int(0))) in
  let exit_blk = bb_finish(xbb, uvir.term_ret(z_r)) in

  let blks = [entry_blk, cond_blk, body_blk, found_blk, inc_blk, exit_blk] in
  let get_fn = uvir.func("__dict_get__", get_params, uvir.ty_any(), blks, uvir.func_attrs(false, false)) in
  [get_fn]
}


fn build_list_helpers(fn_names) {
  // __list_append__(lst, val) -> 0
  let ctx = make_ctx(fn_names) in
  let _ = alloc_reg(ctx) in  // reg 0 = lst
  let _ = alloc_reg(ctx) in  // reg 1 = val
  let app_params = [uvir.param(0, uvir.ty_any(), "lst"), uvir.param(1, uvir.ty_any(), "val")] in
  let len_r   = alloc_reg(ctx) in
  let one_r   = alloc_reg(ctx) in
  let new_len = alloc_reg(ctx) in
  let ret_r   = alloc_reg(ctx) in
  let ebb = make_bb(0) in
  let ebb = bb_emit(ebb, uvir.inst_load(len_r, 0, 0)) in
  let ebb = bb_emit(ebb, uvir.inst_store_dyn(0, len_r, 1)) in
  let ebb = bb_emit(ebb, uvir.inst_const(one_r, uvir.val_int(1))) in
  let ebb = bb_emit(ebb, uvir.inst_int_add(new_len, len_r, one_r)) in
  let ebb = bb_emit(ebb, uvir.inst_store(0, 0, new_len)) in
  let ebb = bb_emit(ebb, uvir.inst_const(ret_r, uvir.val_int(0))) in
  let app_fn = uvir.func("__list_append__", app_params, uvir.ty_any(),
    [bb_finish(ebb, uvir.term_ret(ret_r))], uvir.func_attrs(false, false)) in
  // __list_pop__(lst) -> last element
  let ctx2 = make_ctx(fn_names) in
  let _ = alloc_reg(ctx2) in  // reg 0 = lst
  let pop_params = [uvir.param(0, uvir.ty_any(), "lst")] in
  let len2_r   = alloc_reg(ctx2) in
  let one2_r   = alloc_reg(ctx2) in
  let new_len2 = alloc_reg(ctx2) in
  let val2_r   = alloc_reg(ctx2) in
  let pbb = make_bb(0) in
  let pbb = bb_emit(pbb, uvir.inst_load(len2_r, 0, 0)) in
  let pbb = bb_emit(pbb, uvir.inst_const(one2_r, uvir.val_int(1))) in
  let pbb = bb_emit(pbb, uvir.inst_int_sub(new_len2, len2_r, one2_r)) in
  let pbb = bb_emit(pbb, uvir.inst_load_dyn(val2_r, 0, new_len2)) in
  let pbb = bb_emit(pbb, uvir.inst_store(0, 0, new_len2)) in
  let pop_fn = uvir.func("__list_pop__", pop_params, uvir.ty_any(),
    [bb_finish(pbb, uvir.term_ret(val2_r))], uvir.func_attrs(false, false)) in
  [app_fn, pop_fn]
}

fn lower_module(py_ast) {
  // Collect all function and class names first
  let fn_names = list.map(
    list.filter(py_ast.body, fn(s) { s.t == "FunctionDef" }),
    fn(s) { s.name }) in
  let class_names = list.map(
    list.filter(py_ast.body, fn(s) { s.t == "ClassDef" }),
    fn(s) { s.name }) in
  let class_method_names = list.flatten(list.map(
    list.filter(py_ast.body, fn(s) { s.t == "ClassDef" }),
    fn(s) { list.map(list.filter(s.body, fn(m){ m.t == "FunctionDef" }),
      fn(m){ str.concat([s.name, "__", m.name]) }) })) in
  let all_names = list.concat([fn_names, class_names, class_method_names, ["__main__", "__dict_get__", "__list_append__", "__list_pop__"]]) in

  // Pre-register classes by scanning top-level stmts first
  let pre_ctx = make_ctx(all_names) in
  let _ = list.map(list.filter(py_ast.body, fn(s){ s.t == "ClassDef" }), fn(s) {
    let init_ms = list.filter(s.body, fn(m){ m.t == "FunctionDef" && m.name == "__init__" }) in
    let fields = if list.len(init_ms) > 0 then collect_self_fields(list.get(init_ms, 0).body) else [] in
    let methods = list.fold(s.body, {}, fn(mmap, m) {
      if m.t != "FunctionDef" then mmap
      else rec.set(mmap, m.name, str.concat([s.name, "__", m.name]))
    }) in
    ctx_register_class(pre_ctx, s.name, fields, methods)
  }) in

  // Lower regular function defs
  let fns = list.map(
    list.filter(py_ast.body, fn(s) { s.t == "FunctionDef" }),
    fn(s) { lower_funcdef_with_ctx(s, pre_ctx) }) in

  // Lower class defs -> constructor + methods
  let class_fns = list.flatten(list.map(
    list.filter(py_ast.body, fn(s) { s.t == "ClassDef" }),
    fn(s) { lower_classdef(s, all_names, pre_ctx) })) in

  // Lower top-level statements as __main__
  let top_stmts = list.filter(py_ast.body, fn(s) { s.t != "FunctionDef" && s.t != "ClassDef" }) in
  let ctx = pre_ctx in  // reuse pre_ctx with class registry
  let ebb = make_bb(0) in
  let result = lower_stmts(top_stmts, env_empty(), ebb, ctx) in
  let ret_reg = if result.ret_reg != null then result.ret_reg
    else
      let r = env_get(result.env, "result") in
      if r != null then r
      else
        let last = env_get(result.env, "__last_expr__") in
        if last != null then last else 0 in
  let fblk = bb_finish(result.bb, uvir.term_ret(ret_reg)) in
  let all_blocks = list.concat([result.extra, [fblk]]) in
  let sorted = list.sort_int(list.map(all_blocks, fn(b) { b.label })) in
  let bmap = list.fold(all_blocks, {}, fn(acc, b) { rec.set(acc, str.from(b.label), b) }) in
  let ordered = list.map(sorted, fn(l) { rec.get(bmap, str.from(l)) }) in
  let main_fn = uvir.func("__main__", [], uvir.ty_any(), ordered, uvir.func_attrs(false, false)) in
  let dict_helpers = build_dict_helpers(all_names) in
  let list_helpers = build_list_helpers(all_names) in
  uvir.module("python", list.concat([fns, class_fns, dict_helpers, list_helpers, [main_fn]]), "__main__", [], [])
}

export { lower_module, lower_funcdef, lower_expr }
