/// ocir_dse.fard -- Dead Store Elimination via MemorySSA
///
/// A StoreHeap is dead if:
///   1. The stored location (ptr, offset) is read by no LoadHeap*
///      instruction that is reachable after the store, AND
///   2. The pointer does not escape to a call (which might read it)
///
/// Algorithm (intra-block, conservative):
///   Scan forward through each block's instructions.
///   Maintain a "pending store" map: (ptr_origin, offset) -> inst_index
///   On LoadHeapStaticIdx(ptr, field): mark (origin, field*8+8) as needed
///   On StoreHeap(ptr, offset): if (origin, offset) already pending -> dead
///                               else add to pending
///   On CallI64/CallIndirect: flush all pending (conservative escape)
///   On function exit: all remaining pending stores are dead
///      UNLESS the ptr escapes (is returned or passed to a call)
///
/// Inter-block: uses dominator order -- available store info flows
/// from dominator to dominated blocks (conservative: only kill if
/// store is in the same block and ptr doesn't escape).

import("std/list") as list
import("std/rec")  as rec
import("std/str")  as str

// ── Store location key ────────────────────────────────────────────

fn store_key(ptr_origin, offset) {
  str.concat([str.from(ptr_origin), "@", str.from(offset)])
}

// ── Escape analysis ───────────────────────────────────────────────
// A pointer escapes if it is:
//   - passed to a CallI64 or CallIndirect
//   - returned via MoveI64/CopyI64 that feeds RetI64
//   - stored into another heap location

fn ptr_escapes_in_block(ptr_origin, insts, origin_map) {
  list.any(insts, fn(i) {
    let op = i.op in
    // Conservative: any call may use the pointer
    if op == "CallI64" || op == "CallIndirect" ||
       op == "StrConcat" || op == "StrLen" || op == "StrGet" ||
       op == "StrEq" || op == "IntToStr" then true
    // Store into another heap object (ptr stored as a value)
    else if op == "StoreHeap" && rec.has(i, "src") then
      let src_key = str.from(i.src) in
      let src_origin = if rec.has(origin_map, src_key)
        then rec.get(origin_map, src_key) else -1 in
      src_origin == ptr_origin
    else false
  })
}

// ── Intra-block DSE ───────────────────────────────────────────────

fn field_to_offset(field_idx) {
  8 + field_idx * 8  // heap layout: [fn_ptr(0), field0(8), field1(16), ...]
}

fn dse_block(block, origin_map) {
  let n = list.len(block.insts) in

  // Forward pass: find dead stores
  // pending: store_key -> instruction index (most recent store to that loc)
  // needed: set of store_keys that are read
  // escaped: set of ptr_origins that escape

  let analysis = list.fold(list.build(n, fn(i){i}),
    { pending: {}, needed: {}, escaped: {}, dead: {} },
    fn(acc, i) {
      let inst = list.get(block.insts, i) in
      let op = inst.op in

      if op == "StoreHeap" then
        let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
        let offset = if rec.has(inst,"offset") then inst.offset else 0 in
        let pk = str.from(ptr) in
        let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk)
          else ptr in
        let key = store_key(origin, offset) in
        // If same location was pending and ptr hasn't escaped -> prior store is dead
        if rec.has(acc.pending, key) && !rec.has(acc.escaped, str.from(origin)) then
          let dead_idx = rec.get(acc.pending, key) in
          { pending: rec.set(acc.pending, key, i),
            needed: acc.needed,
            escaped: acc.escaped,
            dead: rec.set(acc.dead, str.from(dead_idx), true) }
        else
          { pending: rec.set(acc.pending, key, i),
            needed: acc.needed,
            escaped: acc.escaped,
            dead: acc.dead }

      else if op == "LoadHeapStaticIdx" then
        let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
        let field = if rec.has(inst,"field_idx") then inst.field_idx else 0 in
        let pk = str.from(ptr) in
        let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk)
          else ptr in
        let offset = field_to_offset(field) in
        let key = store_key(origin, offset) in
        // Mark this location as needed -- its pending store is NOT dead
        { pending: acc.pending,
          needed: rec.set(acc.needed, key, true),
          escaped: acc.escaped,
          dead: acc.dead }

      else if op == "LoadHeap" then
        let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
        let offset = if rec.has(inst,"offset") then inst.offset else 0 in
        let pk = str.from(ptr) in
        let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk)
          else ptr in
        let key = store_key(origin, offset) in
        { pending: acc.pending,
          needed: rec.set(acc.needed, key, true),
          escaped: acc.escaped,
          dead: acc.dead }

      else if op == "CallI64" || op == "CallIndirect" then
        // Conservative: all pending stores may be read by the call
        { pending: {},  // flush pending
          needed: acc.needed,
          escaped: acc.escaped,
          dead: acc.dead }

      else if op == "MoveI64" || op == "CopyI64" then
        // Track pointer propagation for escape
        let src = if rec.has(inst,"src") then inst.src else -1 in
        let sk = str.from(src) in
        let src_origin = if rec.has(origin_map, sk) then rec.get(origin_map, sk)
          else -1 in
        if src_origin >= 0 then
          // propagate origin
          acc
        else acc

      else if op == "StrConcat" || op == "StrLen" || op == "StrGet" ||
              op == "StrEq" || op == "IntToStr" then
        // String ops read heap data via pointers -- mark all pending stores as needed
        let needed2 = list.fold(rec.keys(acc.pending), acc.needed,
          fn(n, k) { rec.set(n, k, true) }) in
        { pending: acc.pending, needed: needed2, escaped: acc.escaped, dead: acc.dead }

      else acc
    }
  ) in

  // Stores remaining in pending at end of block:
  // Dead if their key is NOT in needed (never loaded in this block)
  let never_read_dead = list.fold(rec.keys(analysis.pending), analysis.dead,
    fn(acc, key) {
      if !rec.has(analysis.needed, key) then
        let idx = rec.get(analysis.pending, key) in
        rec.set(acc, str.from(idx), true)
      else acc
    }) in
  let final_dead = never_read_dead in

  // Remove dead stores
  let new_insts = list.filter(
    list.map(list.build(n, fn(i){ { inst: list.get(block.insts, i), idx: i } }),
      fn(x){ x }),
    fn(x){ !rec.has(final_dead, str.from(x.idx)) }
  ) in

  { label: block.label,
    insts: list.map(new_insts, fn(x){ x.inst }),
    term: block.term }
}

// ── Function-level DSE ────────────────────────────────────────────

fn build_origin_map_for_dse(f) {
  // Simple alloc-origin tracking for DSE
  list.fold(f.blocks, {}, fn(acc, block) {
    list.fold(block.insts, acc, fn(a, inst) {
      let op = inst.op in
      if op == "AllocHeap" || op == "MakeClosure" then
        rec.set(a, str.from(inst.dst), inst.dst)
      else if op == "MoveI64" || op == "CopyI64" then
        if rec.has(inst, "src") then
          let sk = str.from(inst.src) in
          if rec.has(a, sk) then rec.set(a, str.from(inst.dst), rec.get(a, sk))
          else a
        else a
      else a
    })
  })
}

fn dse_func(f) {
  let origin_map = build_origin_map_for_dse(f) in
  let new_blocks = list.map(f.blocks, fn(b){ dse_block(b, origin_map) }) in
  { name: f.name, params: f.params, blocks: new_blocks }
}

fn dse_module(m) {
  { entry: m.entry, funcs: list.map(m.funcs, dse_func) }
}


// ── Cross-block DSE ───────────────────────────────────────────────
// A StoreHeap in block B to location (origin, offset) is dead iff:
//   1. No load of (origin, offset) is reachable from after the store
//      before another store to the same location (cross-block liveness)
//   2. The ptr_origin does not escape the function (not returned, not
//      passed to a call that outlives the current frame)
//
// Implementation:
//   - Compute escaped_origins: set of ptr_origins that flow into RetI64
//     or CallI64/CallIndirect args across all blocks
//   - Compute live_out[B][key]: backward dataflow
//   - In each block backward scan: mark StoreHeap dead if !live_out && !escaped

fn successors_of(term) {
  if term.op == "Br" then [term.to]
  else if term.op == "BrCond" then [term.then_blk, term.else_blk]
  else []
}

fn union_sets(a, b) {
  list.fold(rec.keys(b), a, fn(acc, k) { rec.set(acc, k, true) })
}

fn diff_sets(a, b) {
  list.fold(rec.keys(a), {}, fn(acc, k) {
    if rec.has(b, k) then acc else rec.set(acc, k, true)
  })
}

fn compute_escaped_origins(blocks, origin_map) {
  // A ptr_origin escapes if:
  //   - it flows into RetI64 (via CopyI64/MoveI64 chains)
  //   - it is passed as arg to CallI64/CallIndirect
  // Conservative: track all registers that flow from AllocHeap
  // and mark escaped if used in ret or call args
  list.fold(blocks, {}, fn(acc, block) {
    list.fold(block.insts, acc, fn(a, inst) {
      let op = inst.op in
      if op == "CallI64" || op == "CallIndirect" then
        // All args that are ptr origins escape
        let args = if rec.has(inst, "args") then inst.args else [] in
        list.fold(args, a, fn(a2, arg) {
          let pk = str.from(arg) in
          if rec.has(origin_map, pk)
            then rec.set(a2, str.from(rec.get(origin_map, pk)), true)
            else a2
        })
      else a
    })
  })
}

fn block_gen_kill(block, origin_map) {
  // Forward scan: gen = keys read before written; kill = keys written
  let n = list.len(block.insts) in
  list.fold(list.build(n, fn(i){i}), { gen: {}, kill: {} }, fn(acc, i) {
    let inst = list.get(block.insts, i) in
    let op = inst.op in
    if op == "StoreHeap" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let offset = if rec.has(inst,"offset") then inst.offset else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, offset) in
      { gen: acc.gen, kill: rec.set(acc.kill, key, true) }
    else if op == "LoadHeapStaticIdx" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let field = if rec.has(inst,"field_idx") then inst.field_idx else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, field_to_offset(field)) in
      if rec.has(acc.kill, key) then acc
      else { gen: rec.set(acc.gen, key, true), kill: acc.kill }
    else if op == "LoadHeap" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let offset = if rec.has(inst,"offset") then inst.offset else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, offset) in
      if rec.has(acc.kill, key) then acc
      else { gen: rec.set(acc.gen, key, true), kill: acc.kill }
    else acc
  })
}

fn compute_live_out(blocks, origin_map) {
  // Backward dataflow: live_out[B] = union over succs S of live_in[S]
  // live_in[B] = gen[B] | (live_out[B] - kill[B])
  let gk_map = list.fold(blocks, {}, fn(acc, b) {
    rec.set(acc, str.from(b.label), block_gen_kill(b, origin_map))
  }) in
  let init = list.fold(blocks, {}, fn(acc, b) {
    rec.set(acc, str.from(b.label), {})
  }) in
  // 20 iterations for convergence
  list.fold(list.build(20, fn(i){i}), init, fn(live, _) {
    list.fold(blocks, live, fn(live2, b) {
      let lbl = str.from(b.label) in
      let succs = successors_of(b.term) in
      let live_out = list.fold(succs, {}, fn(acc, s) {
        let slbl = str.from(s) in
        if rec.has(live2, slbl) then
          let sgk = rec.get(gk_map, slbl) in
          let s_live_in = union_sets(sgk.gen, diff_sets(rec.get(live2, slbl), sgk.kill)) in
          union_sets(acc, s_live_in)
        else acc
      }) in
      rec.set(live2, lbl, live_out)
    })
  })
}

fn dse_block_xb(block, origin_map, live_out_map, escaped_origins) {
  let n = list.len(block.insts) in
  let lbl = str.from(block.label) in
  let block_live_out = if rec.has(live_out_map, lbl) then rec.get(live_out_map, lbl) else {} in
  // Collect local allocs in this block
  let local_allocs = list.fold(block.insts, {}, fn(acc, inst) {
    if inst.op == "AllocHeap" || inst.op == "MakeClosure"
      then rec.set(acc, str.from(inst.dst), true)
      else acc
  }) in
  let result = list.fold(list.build(n, fn(i){ n - 1 - i }), { live: block_live_out, dead: {} }, fn(acc, i) {
    let inst = list.get(block.insts, i) in
    let op = inst.op in
    if op == "StoreHeap" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let offset = if rec.has(inst,"offset") then inst.offset else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, offset) in
      let is_local = rec.has(local_allocs, str.from(origin)) in
      let escapes = rec.has(escaped_origins, str.from(origin)) in
      if !rec.has(acc.live, key) && is_local && !escapes then
        { live: acc.live, dead: rec.set(acc.dead, str.from(i), true) }
      else
        { live: diff_sets(acc.live, rec.set({}, key, true)), dead: acc.dead }
    else if op == "LoadHeapStaticIdx" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let field = if rec.has(inst,"field_idx") then inst.field_idx else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, field_to_offset(field)) in
      { live: rec.set(acc.live, key, true), dead: acc.dead }
    else if op == "LoadHeap" then
      let ptr = if rec.has(inst,"ptr") then inst.ptr else -1 in
      let offset = if rec.has(inst,"offset") then inst.offset else 0 in
      let pk = str.from(ptr) in
      let origin = if rec.has(origin_map, pk) then rec.get(origin_map, pk) else ptr in
      let key = store_key(origin, offset) in
      { live: rec.set(acc.live, key, true), dead: acc.dead }
    else if op == "CallI64" || op == "CallIndirect" ||
            op == "StrConcat" || op == "StrLen" || op == "StrGet" ||
            op == "StrEq" || op == "IntToStr" then
      // Conservative: all heap keys become live (calls may read anything)
      { live: union_sets(acc.live, block_live_out), dead: acc.dead }
    else acc
  }) in
  let new_insts = list.filter(
    list.map(list.build(n, fn(i){ { inst: list.get(block.insts, i), idx: i } }), fn(x){ x }),
    fn(x){ !rec.has(result.dead, str.from(x.idx)) }
  ) in
  { label: block.label, insts: list.map(new_insts, fn(x){ x.inst }), term: block.term }
}

fn dse_func_xb(f) {
  let origin_map = build_origin_map_for_dse(f) in
  let live_out = compute_live_out(f.blocks, origin_map) in
  let escaped = compute_escaped_origins(f.blocks, origin_map) in
  let new_blocks = list.map(f.blocks, fn(b){ dse_block_xb(b, origin_map, live_out, escaped) }) in
  { name: f.name, params: f.params, blocks: new_blocks }
}

fn dse_module_xb(m) {
  { entry: m.entry, funcs: list.map(m.funcs, dse_func_xb) }
}

export { dse_module, dse_func, dse_block, build_origin_map_for_dse, dse_module_xb, dse_func_xb }